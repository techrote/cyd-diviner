# Keep original root summaries/manifests/reports and all stimulus inputs visible.
/evidence/metal-*-demod/*/
/evidence/metal-*-envelope/*/
/evidence/sdr-framed-*-analysis*/*/
/evidence/sdr-signals-*/*/
/evidence/audio-offline-osr*/*/
