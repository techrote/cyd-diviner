{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techrote/cyd-diviner/tools/perf/results.schema.json",
  "title": "CYD physical performance capture version 1",
  "type": "object",
  "required": ["schema", "evidence_class", "source_sha", "firmware_sha256", "profile", "board", "status", "runs"],
  "properties": {
    "schema": {"const": "cyd-perf-capture/1"},
    "evidence_class": {"const": "physical_measured"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "firmware_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tree_state": {"type": "string"},
    "profile": {"type": "string"},
    "board": {"type": "object", "required": ["board"]},
    "status": {"type": "string"},
    "target_info": {"type": "array", "items": {"type": "object"}},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workload", "status"],
        "properties": {
          "workload": {"type": "string"},
          "status": {"enum": ["IN PROGRESS", "MEASURED", "NOT RUN"]},
          "reason": {"type": "string"},
          "run_id": {"type": "string"},
          "target": {"type": "array", "items": {"type": "object"}},
          "target_partial": {"type": "array", "items": {"type": "object"}},
          "settings": {"type": "object"},
          "pcm": {"type": "object"},
          "stress_assessment": {"type": "object"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
